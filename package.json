{
  "name": "blazedemo147adv",
  "version": "1.0.0",
  "description": "Projeto de automação web com Playwright",
  "main": "index.js",
 "scripts": {
    "test": "npx playwright test",
    "test:bdd": "cucumber-js features/**/*.feature --require steps/**/*.steps.js --require support/**/*.js --format json:reports/cucumber-report.json",
    "test:bdd:headed": "cross-env HEADLESS=false npm run test:bdd",
    "report": "node generate-report.js"
  },  
  "keywords": [],npm install cross-env --save-dev
 
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "cucumber-html-reporter": "^6.0.0",    
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.7.0"
  }
}
